def introduce_game():
    print("植物育成ゲーム")
    print("endは全部で7種類です。準備はいいですか？")
    choice = input("Start")
    if choice =="Start":
        start_game()
    else :
        print("植物は枯れてしまった…")
def start_game():
    counts_water = {"1":0}
    counts_light = {"2":0}
    while True:
        print("元気な植物を育てましょう。")
        print("どちらを与えますか？")
        choice = input("1:水,2:光")
        if choice =="1":
            print("水を与えた")
            counts_water[choice] += 1 #水カウントを1増やす
            if counts_water-counts_light>=30:
                print("水の与えすぎでエラ呼吸に進化した！！")
                fishplant_game()
            if counts_water ==100:
                print("植物は元気に育った。")
                print("end1:成功エンド")
                print("遊んでいただきありがとうございました。是非他のエンドも見つけてみてください。")
                introduce_game()
            if counts_water ==35:
                print("葉が大きくなった。")
        elif choice =="2":
            print("光を与えた")
            counts_light[choice] +=1 #光カウントを1増やす
            if counts_light-counts_water>=10:
                print("植物は干からびてしまった…")
                print("end2:干物エンド")
                print("新しく始めますか？")
                choice = input("1:新しく始める")
                if choice =="1":
                    start_game()
                else:
                    print("その選択肢はありません。")
            if counts_light ==100:
                print("植物は元気に育った。")
                print("end1:成功エンド")
                print("遊んでいただきありがとうございました。是非他のエンドも見つけてみてください。")
                introduce_game()
            if counts_light ==30:
                print("幹が太くなった。")
                
